# MangkukKembara — Web Client Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored (matched by *.local) and will NOT be committed.
#
# ┌──────────────────────────────────────────────────────────────────────┐
# │  ONLY public/client-safe values belong here.                       │
# │                                                                     │
# │  NEVER add:                                                         │
# │    - Supabase service_role key                                      │
# │    - Cloudinary API secret                                          │
# │    - Any server-side secret                                         │
# │                                                                     │
# │  Cloudinary credentials are stored as Supabase Edge Function        │
# │  secrets. See SUPABASE_CLOUDINARY_SETUP.md for instructions.        │
# └──────────────────────────────────────────────────────────────────────┘

# Supabase — public project credentials
# Found in: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://uifpiyqhzhtclwdpbbxr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_He5cSZpzDI6EpafVSOQLeg_Q4kyg3dx
